<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reusable OpenF1 client with no Race Replay references, packable on its own (07 §9.3). -->
    <IsPackable>true</IsPackable>
    <PackageId>OpenF1.Client</PackageId>
    <Description>Typed .NET client for the OpenF1 historical API: DTOs, source-generated JSON, response cache, rate limiting and resilience.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>
</Project>
