@* Play/pause, playback rate and the time readout (FR-03, docs/05 §3.3). *@
@implements IDisposable
@inject ReplaySessionHost Host
@inject ReplayStore Store

<div class="playback-controls">
    <button type="button" class="play-pause" aria-label="@(State.IsPlaying ? "Pause" : "Play")" @onclick="Toggle">
        <span aria-hidden="true">@(State.IsPlaying ? "❚❚" : "▶")</span>
    </button>

    <select class="rate" aria-label="Playback rate" value="@Invariant(State.Rate)" @onchange="SetRate">
        @foreach (double rate in Host.Options.Rates)
        {
            <option value="@Invariant(rate)">@Invariant(rate)×</option>
        }
    </select>

    <output class="time-readout">@TimeFormat.Clock(State.Position) / @TimeFormat.Clock(State.Duration)</output>
</div>

@code {
    private ReplayViewState State => Store.State;

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        if (Host.Clock?.IsPlaying == true)
        {
            Host.Control?.Pause();
        }
        else
        {
            Host.Control?.Play();
        }
    }

    private void SetRate(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double rate)
            && Host.Options.Rates.Contains(rate))
        {
            Host.Control?.SetRate(rate);
        }
    }

    private static string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);

    public void Dispose() => Store.Changed -= OnChanged;
}
