@* Play/pause, playback rate and the time readout (FR-03, docs/05 §3.3). *@
@implements IDisposable
@inject ReplaySessionHost Host
@inject ReplayStore Store

<div class="playback-controls">
    <button type="button" class="play-pause" aria-label="@(State.IsPlaying ? "Pause" : "Play")" @onclick="Toggle">
        <span aria-hidden="true">@(State.IsPlaying ? "❚❚" : "▶")</span>
    </button>

    <select class="rate" aria-label="Playback rate" value="@InvariantNumber.Format(State.Rate)" @onchange="SetRate">
        @foreach (double rate in Host.Options.Rates)
        {
            <option value="@InvariantNumber.Format(rate)">@InvariantNumber.Format(rate)×</option>
        }
    </select>

    @* A plain span, not <output>: that is a live region, and this changes up to 10 times a second. *@
    <span class="time-readout">@TimeFormat.Clock(State.Position) / @TimeFormat.Clock(State.Duration)</span>
</div>

@code {
    private ReplayViewState State => Store.State;

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        if (Host.Clock?.IsPlaying == true)
        {
            Host.Control?.Pause();
        }
        else
        {
            Host.Control?.Play();
        }
    }

    private void SetRate(ChangeEventArgs e)
    {
        if (InvariantNumber.TryParse(e.Value, out double rate) && Host.Options.Rates.Contains(rate))
        {
            Host.Control?.SetRate(rate);
        }
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
