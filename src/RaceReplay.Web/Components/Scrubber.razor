@* The timeline (FR-04). Dragging pauses movement and the cars follow the thumb on every input event; releasing
   resumes if the replay was playing (docs/05 §3.3, NFR-02). Keyboard input seeks directly. *@
@implements IDisposable
@inject ReplaySessionHost Host
@inject ReplayStore Store

@* max is rounded up so the last whole step reaches the end; the clock clamps the seek to the duration. *@
<input type="range" class="scrubber" aria-label="Replay position"
       min="0" max="@InvariantNumber.Format(Math.Ceiling(State.Duration))" step="1"
       value="@InvariantNumber.Format(State.Position)"
       aria-valuetext="@_valueText"
       @onpointerdown="() => _gesture.Begin(Host.Control)"
       @oninput="e => ScrubGesture.Seek(Host.Control, e.Value)"
       @onpointerup="() => _gesture.End(Host.Control)"
       @onpointercancel="() => _gesture.End(Host.Control)"
       @onchange="() => _gesture.End(Host.Control)" />

@code {
    private readonly ScrubGesture _gesture = new();
    private string _valueText = string.Empty;

    private ReplayViewState State => Store.State;

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        UpdateValueText();
    }

    private void OnChanged()
    {
        UpdateValueText();
        _ = InvokeAsync(StateHasChanged);
    }

    // Only while paused or scrubbing: a focused slider's value text changing 10 times a second floods screen readers.
    private void UpdateValueText()
    {
        if (!State.IsPlaying || _gesture.IsActive)
        {
            _valueText = TimeFormat.Spoken(State.Position);
        }
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
