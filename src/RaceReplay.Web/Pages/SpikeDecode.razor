@page "/spike/decode"
@attribute [System.Runtime.Versioning.SupportedOSPlatform("browser")]
@using System.Buffers.Binary
@using System.Diagnostics
@using System.IO.Compression
@using System.Runtime.InteropServices
@using System.Text.Json
@using RaceReplay.Bundle
@using RaceReplay.Web.Interop
@inject HttpClient Http

@* Spike S2 (throwaway, branch spike/s2-browser): decode costs of the hosted-bundle options (docs/04 §9). *@

<PageTitle>S2 decode · Race Replay</PageTitle>

<div class="replay">
    <h1>S2: decode times</h1>
    <p>
        Fetches the 2-hour variants from <code>spike-s2/</code>, then times each decode once cold and @Runs times warm.
        Times in ms, as cold / median warm.
    </p>
    <p><button @onclick="RunAsync" disabled="@_running">Run</button> @_status</p>

    <table class="spike-table">
        <thead>
            <tr>
                <th>Variant</th><th>.gz bytes</th><th>GZipStream (.NET)</th><th>DecompressionStream (JS)</th>
                <th>JS → .NET hand-over</th><th>Delta prefix sums</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Row r in _rows)
            {
                <tr>
                    <td>@r.Variant</td><td>@r.GzipBytes.ToString("N0")</td><td>@Pair(r.DotNetGunzip)</td><td>@Pair(r.JsGunzip)</td>
                    <td>@Pair(r.HandOver)</td><td>@Pair(r.PrefixSums)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_bundleRead is not null)
    {
        <p>Raw 2-hour bundle, <code>ReplayBundleReader.Read</code> (parse, checks, dequantise): @Pair(_bundleRead)</p>
    }
</div>

@code {
    private const int Runs = 5;
    private static readonly string[] s_variants = ["raw", "delta", "delta-qprogress"];

    private readonly List<Row> _rows = [];
    private Timing? _bundleRead;
    private bool _running;
    private string _status = "";

    private sealed record Timing(double Cold, double Warm);

    private sealed record Row(string Variant, long GzipBytes, Timing DotNetGunzip, Timing JsGunzip, Timing HandOver, Timing? PrefixSums);

    private async Task RunAsync()
    {
        _running = true;
        _rows.Clear();
        _bundleRead = null;
        try
        {
            foreach (string variant in s_variants)
            {
                _status = $"Measuring {variant}…";
                StateHasChanged();
                await Task.Yield();

                string url = $"spike-s2/variants/positions.{variant}.rrb.gz";
                byte[] gz = await Http.GetByteArrayAsync(url);
                int size = (int)BinaryPrimitives.ReadUInt32LittleEndian(gz.AsSpan(gz.Length - 4)); // gzip ISIZE

                byte[] decoded = [];
                Timing dotnet = Time(() => decoded = Gunzip(gz, size));

                List<double> js = [], handOver = [];
                for (int i = 0; i <= Runs; i++)
                {
                    await SpikeInterop.FetchHeld(url);
                    js.Add(await SpikeInterop.GunzipHeld());
                    long begin = Stopwatch.GetTimestamp();
                    byte[] taken = SpikeInterop.TakeHeld();
                    handOver.Add(Stopwatch.GetElapsedTime(begin).TotalMilliseconds);
                    if (!taken.AsSpan().SequenceEqual(decoded))
                    {
                        throw new InvalidDataException($"{variant}: JS and .NET decoded different bytes.");
                    }
                }

                Timing? sums = variant == "raw" ? null : Time(() => PrefixSums((byte[])decoded.Clone()), excludeCopy: decoded.Length);
                _rows.Add(new Row(variant, gz.Length, dotnet, Summarise(js), Summarise(handOver), sums));
            }

            _status = "Measuring the bundle reader…";
            StateHasChanged();
            await Task.Yield();
            byte[] manifest = await Http.GetByteArrayAsync("spike-s2/bundle-2h/manifest.json");
            byte[] positions = await Http.GetByteArrayAsync("spike-s2/bundle-2h/positions.rrb");
            _bundleRead = Time(() => ReplayBundleReader.Read(manifest, positions));
            _status = "Done.";
            SpikeInterop.Log("S2 decode " + JsonSerializer.Serialize(new { rows = _rows, bundleRead = _bundleRead }));
        }
        catch (Exception ex)
        {
            _status = $"{ex.GetType().Name}: {ex.Message}";
            SpikeInterop.Log("S2 decode error " + _status);
        }
        finally
        {
            _running = false;
        }
    }

    private static byte[] Gunzip(byte[] gz, int size)
    {
        byte[] output = new byte[size];
        using GZipStream stream = new(new MemoryStream(gz, writable: false), CompressionMode.Decompress);
        stream.ReadExactly(output);
        return output;
    }

    // Undoes the candidate encodings in place: flag bit 0 makes every Int16 block a running sum of differences, and
    // encoding 4 holds progress as Int32 differences of whole track units (scripts/s2-variants.cs).
    private static void PrefixSums(byte[] file)
    {
        bool delta = (BinaryPrimitives.ReadUInt32LittleEndian(file.AsSpan(36)) & 1) != 0;
        int directory = (int)BinaryPrimitives.ReadUInt32LittleEndian(file.AsSpan(40));
        int count = (int)BinaryPrimitives.ReadUInt32LittleEndian(file.AsSpan(44));
        for (int i = 0; i < count; i++)
        {
            ReadOnlySpan<byte> entry = file.AsSpan(directory + (i * 16), 16);
            ushort encoding = BinaryPrimitives.ReadUInt16LittleEndian(entry[4..]);
            Span<byte> block = file.AsSpan(
                (int)BinaryPrimitives.ReadUInt32LittleEndian(entry[8..]), (int)BinaryPrimitives.ReadUInt32LittleEndian(entry[12..]));
            if (delta && encoding == 1)
            {
                Span<short> values = MemoryMarshal.Cast<byte, short>(block);
                for (int k = 1; k < values.Length; k++)
                {
                    values[k] = unchecked((short)(values[k] + values[k - 1]));
                }
            }
            else if (encoding == 4)
            {
                Span<int> values = MemoryMarshal.Cast<byte, int>(block);
                for (int k = 1; k < values.Length; k++)
                {
                    values[k] += values[k - 1];
                }
            }
        }
    }

    // One cold run, then the median of Runs warm runs. The clone in the prefix-sum runs is timed separately and taken off.
    private static Timing Time(Action action, int excludeCopy = 0)
    {
        List<double> runs = [];
        for (int i = 0; i <= Runs; i++)
        {
            long begin = Stopwatch.GetTimestamp();
            action();
            runs.Add(Stopwatch.GetElapsedTime(begin).TotalMilliseconds);
        }

        if (excludeCopy > 0)
        {
            byte[] source = new byte[excludeCopy];
            long begin = Stopwatch.GetTimestamp();
            _ = (byte[])source.Clone();
            double copy = Stopwatch.GetElapsedTime(begin).TotalMilliseconds;
            runs = [.. runs.Select(r => Math.Max(0, r - copy))];
        }

        return Summarise(runs);
    }

    private static Timing Summarise(List<double> runs)
    {
        double[] warm = [.. runs.Skip(1).Order()];
        return new Timing(Math.Round(runs[0], 2), Math.Round(warm[warm.Length / 2], 2));
    }

    private static string Pair(Timing? t) => t is null ? "–" : $"{t.Cold:F1} / {t.Warm:F1}";
}
